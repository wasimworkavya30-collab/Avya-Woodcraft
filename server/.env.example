# Copy this file to .env and fill in the values. Never commit the real .env file.

PORT=4000

# Supabase > Project Settings > Database > Connection string (use the "Session pooler" URI).
# Replace [YOUR-PASSWORD] with the database password you chose.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Set to false only for a local Postgres without SSL.
DATABASE_SSL=true

# Long random strings (32+ characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DEVICE_TOKEN_SECRET=change-me-to-a-different-long-random-string

# The one Main Admin login.
ADMIN_EMAIL=admin@avyawoodcraft.in
ADMIN_PASSWORD=change-this-strong-password

COMPANY_NAME=Avya Woodcraft LLP
TIMEZONE=Asia/Kolkata

# Frontend address(es) allowed to call this API. Separate several with commas.
CLIENT_ORIGIN=http://localhost:5173

# Default workshop location. The admin can change these later in Settings.
# Leave 0 to set the location from the admin Settings page instead.
WORKSHOP_LAT=0
WORKSHOP_LNG=0
GEOFENCE_RADIUS_M=150

# Selfie storage (Supabase Storage). Settings > API: Project URL and service_role key.
# If left empty, selfies are saved to server/uploads (local development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=selfies
