# Copy to .env (local) or set these in Vercel / Netlify project settings.

# Address of the backend API (no trailing slash).
# Leave empty for local development: Vite forwards /api to http://localhost:4000.
VITE_API_URL=https://your-backend.onrender.com

# Company time zone used to show times and dates.
VITE_TIMEZONE=Asia/Kolkata
